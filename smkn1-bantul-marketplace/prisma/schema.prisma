// This is your Prisma schema file for SMKN 1 Bantul Marketplace & BLUD Portal
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  SUPER_ADMIN_BLUD
  ADMIN_JURUSAN
  BUYER
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PartnershipStatus {
  PENDING
  APPROVED
  REJECTED
}

// Models
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(BUYER)
  majorId   String?
  major     Major?   @relation(fields: [majorId], references: [id])
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Major {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  products    ProductService[]
  users       User[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([slug])
}

model ProductService {
  id          String       @id @default(cuid())
  majorId     String
  major       Major        @relation(fields: [majorId], references: [id])
  title       String
  description String?
  price       Decimal
  type        ProductType  @default(PRODUCT)
  galleryUrls String[]
  bludCode    String?
  isActive    Boolean      @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([majorId])
  @@index([type])
  @@index([isActive])
}

model Order {
  id              String        @id @default(cuid())
  buyerId         String?
  buyer           User?         @relation(fields: [buyerId], references: [id])
  buyerName       String
  buyerEmail      String
  buyerPhone      String?
  totalAmount     Decimal
  paymentStatus   PaymentStatus @default(UNPAID)
  orderStatus     OrderStatus   @default(PENDING)
  paymentGateway  String?
  paymentId       String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([buyerId])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id])
  productId         String
  product           ProductService @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal
  subtotal          Decimal
  createdAt         DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
}

model B2BPartnership {
  id              String            @id @default(cuid())
  companyName     String
  contactPerson   String
  contactEmail    String
  contactPhone    String?
  proposalDetails String
  status          PartnershipStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([contactEmail])
}
